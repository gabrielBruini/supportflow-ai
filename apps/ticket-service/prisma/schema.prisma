generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SenderType {
  CUSTOMER
  AGENT
  SYSTEM
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  customerId  String
  assignedTo  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    Message[]

  @@index([customerId])
  @@index([status])
  @@index([assignedTo])
  @@index([customerId, status])
  @@map("tickets")
}

model Message {
  id         String     @id @default(uuid())
  ticketId   String
  senderId   String
  senderType SenderType
  content    String
  createdAt  DateTime   @default(now())
  ticket     Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("messages")
}
